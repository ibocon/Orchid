@namespace Orchid.Web.Component

<MudTable Items="@Items"
          Hover="true"
          Breakpoint="Breakpoint.Sm"
          Loading="@(Items == null)"
          LoadingProgressColor="Color.Info"
          Elevation="2">
    <HeaderContent>
        <MudTh>타입</MudTh>
        <MudTh>시간</MudTh>
        <MudTh>상태</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="타입">
            <MudChip T="string" Color="Color.Primary" Size="MudSize.Small" Variant="Variant.Filled">
                @context.ContentType.ToString()
            </MudChip>
        </MudTd>
        <MudTd DataLabel="시간">
            <MudText Typo="Typo.body2">
                @context.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            </MudText>
        </MudTd>
        <MudTd DataLabel="상태">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                E2EE 암호화됨 (@context.CipherText.Length bytes)
            </MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4 text-center">표시할 클립보드 내역이 없습니다.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    /// <summary>
    /// 가상화 목록에 표시할 클립보드 엔티티 컬렉션입니다.
    /// </summary>
    [Parameter]
    public ICollection<ClipboardItem> Items { get; set; } = [];
}
